# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# .env.local is gitignored and is where YOUR machine's configuration belongs.
# Never put a real credential in a file that git tracks: once it is in a commit
# it is in the history forever, and deleting the file later does not remove it.
# Deployed environments get these values from the AWS Amplify console
# (App settings > Environment variables), per branch.
#
# ---------------------------------------------------------------------------
# SERVER-ONLY. Never sent to the browser. Real secrets go here.
# ---------------------------------------------------------------------------

# HubSpot private-app token used by /api/create-hubspot-lead to create and
# update CRM contacts. Needs the crm.objects.contacts.write scope.
# Create at: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_API_KEY=REPLACE_ME_hubspot_private_app_token

# Optional. Name of the HubSpot checkbox property used to tag which environment
# a contact came from. Defaults to environment__dev when unset.
# HUBSPOT_ENV_DEV_PROPERTY_NAME=environment__dev

# Optional. Companion property for production. Leave unset unless the portal
# actually has one.
# HUBSPOT_ENV_PROD_PROPERTY_NAME=environment__prod

# Optional. DynamoDB table backing the API rate limiter. When unset, the
# limiter falls back to an in-memory store whose counters are per-Lambda and
# therefore not actually enforced across instances -- fine locally, not in
# production. Table needs a String partition key named `pk` and TTL enabled on
# the `ttl` attribute.
# RATE_LIMIT_TABLE_NAME=hypernova-rate-limits-prod

# Optional. Salt used when hashing client IPs into rate-limit keys, so the
# store never holds a raw IP address. Set to any long random string; changing
# it resets everyone's counters.
# RATE_LIMIT_SALT=

# Optional. Cloudflare Turnstile secret. When unset, the spam guard runs only
# its free honeypot and timing checks -- the site keeps working, with less
# protection. Never set the secret without also setting the public site key.
# TURNSTILE_SECRET_KEY=

# Optional. Verified SES sender for the "email me my estimate" feature. When
# unset, the mailer logs instead of sending -- the estimator still works, the
# email simply does not go out. A new AWS account is SES-sandboxed until you
# request production access, and in the sandbox you can only send to verified
# addresses.
# SES_FROM_ADDRESS=estimates@hypernova.inc

# Postal address included in the estimate email footer, required by CAN-SPAM.
# COMPANY_POSTAL_ADDRESS=Hypernova Inc, 123 Example St, City, ST 00000

# ---------------------------------------------------------------------------
# PUBLIC. Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle
# and is readable by anyone who opens devtools. Treat these as published.
# They are listed here so a new developer knows what exists, not because they
# are sensitive.
# ---------------------------------------------------------------------------

# Which backend and analytics environment this build talks to: dev | prod.
# Controls which amplifyconfiguration.*.json is loaded in pages/_app.tsx.
NEXT_PUBLIC_APP_ENV=dev

# Google Tag Manager container. GTM_AUTH_PARAMS selects a GTM *environment*
# (dev/staging/live) and is empty for the live snippet.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GTM_AUTH_PARAMS=
NEXT_PUBLIC_GTM_ENV=dev

# Google Analytics 4 measurement ID for this environment's stream.
NEXT_PUBLIC_GA_ID=

# Advertising pixels. Each block in pages/_app.tsx is skipped when its variable
# is unset, so leaving these blank locally is the norm.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
NEXT_PUBLIC_TWITTER_PIXEL_ID=

# Set true to get [tracking], [GTM] and [LI] diagnostics in the browser console
# while developing. Never enable in production.
NEXT_PUBLIC_ENABLE_GA4_LOCALHOST=true

# Cloudflare Turnstile site key. Pairs with TURNSTILE_SECRET_KEY above.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# HubSpot Meetings slug for /book-a-meeting, e.g. "hypernova/discovery".
# Without it the page shows an email fallback instead of a calendar.
NEXT_PUBLIC_HUBSPOT_MEETING_SLUG=
